<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- 항목별 장보기 알림: 알림 표시(13+ 런타임) + 재부팅 후 알림 재등록 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 쇼핑몰 앱 바로가기: packages StoreSearch may open (keep in sync with StoreSearch.apps). -->
    <queries>
        <package android:name="com.coupang.mobile" />
        <package android:name="com.dbs.kurly.m2" />
        <package android:name="kr.co.emart24.everse" />
        <package android:name="com.emarteveryday" />
        <package android:name="kr.co.emart.emartmall" />
        <package android:name="com.emart.today" />
        <package android:name="kr.co.ssg" />
        <package android:name="com.socialapps.homeplus" />
        <package android:name="com.lottemart.lmscp" />
        <package android:name="com.lotte" />
        <package android:name="com.uxlayer.wipoint" />
        <package android:name="com.gaeasoft.oasis" />
        <package android:name="com.nonghyup.hanaromartapp" />
        <package android:name="kr.co.elandmall.kimsclub" />
        <package android:name="com.gsr.gs25" />
        <package android:name="com.bgfcu.membership" />
        <package android:name="com.sampleapp" />
        <package android:name="com.oliveyoung" />
        <package android:name="com.elevenst" />
        <package android:name="com.ebay.kr.gmarket" />
        <package android:name="com.ebay.kr.auction" />
        <package android:name="com.musinsa.store" />
        <package android:name="com.einnovation.temu" />
        <package android:name="com.alibaba.aliexpresshd" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GroceryNote"
        tools:targetApi="36">

        <!-- AdMob app ID — injected per buildType via manifestPlaceholders
             (debug = Google test id, release = real id). See app/build.gradle.kts -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.GroceryNote.SplashScreen"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- 받은 목록 링크 (1.5.0): 목록 페이지가 intent://add?…#Intent;scheme=martnote 로 연다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="martnote" android:host="add" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 목록 위젯: "어떤 마트를 보여줄까요?" on placement / long-press → 설정 -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.GroceryNote">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.WidgetPinSuccessReceiver"
            android:exported="false" />

        <!-- 항목 알림 알람 수신 → 알림 표시 (명시적 인텐트로만 호출, 비공개) -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <!-- 재부팅 후 미래 알림 재등록 (inexact 알람은 재부팅 시 소실됨) -->
        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>


        <receiver
            android:name=".widget.GroceryWidgetMediumReceiver"
            android:exported="true"
            android:label="@string/widget_label_list">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/grocery_widget_medium_info" />
        </receiver>


        <receiver
            android:name=".widget.GroceryWidget2x1Receiver"
            android:exported="true"
            android:label="@string/widget_label_count">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/grocery_widget_2x1_info" />
        </receiver>


    </application>

</manifest>
