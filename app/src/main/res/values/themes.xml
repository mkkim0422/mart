<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Bridge theme: AppCompat DayNight, since Compose owns all visual styling. -->
    <style name="Theme.GroceryNote" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor" tools:targetApi="21">@android:color/transparent</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowBackground">@color/bg_primary</item>
    </style>

    <!-- Android 12+ SplashScreen API. Pre-12 falls back to a static window bg. -->
    <style name="Theme.GroceryNote.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.GroceryNote</item>
    </style>

</resources>
