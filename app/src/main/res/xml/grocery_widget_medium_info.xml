<?xml version="1.0" encoding="utf-8"?>
<!-- 목록 위젯: pick the mart on placement (configure), change it via long-press → 설정
     (reconfigurable). configuration_optional (API 31+): a launcher may place it as
     "전체 마트" without asking; the in-app picker asks before pinning instead. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="480dp"
    android:maxResizeHeight="600dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="0"
    android:description="@string/widget_description_medium"
    android:initialLayout="@layout/widget_preview_medium"
    android:previewLayout="@layout/widget_preview_medium"
    android:configure="com.rldjrgo.grocerynote.widget.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable|configuration_optional" />
