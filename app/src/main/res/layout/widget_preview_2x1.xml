<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews-safe: no bare <View>. 2x1 = same per-mart count rows as Small,
     just the top mart(s) that fit the one-cell-tall footprint. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_pv_card"
    android:padding="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="3dp">
        <TextView android:layout_width="18dp" android:layout_height="18dp"
            android:background="@drawable/widget_preview_bg_yellow" android:gravity="center"
            android:text="🛒" android:textSize="10sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp" android:text="이마트"
            android:textColor="#191F28" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/widget_preview_pill_yellow" android:paddingHorizontal="6dp"
            android:paddingVertical="1dp" android:text="5" android:textColor="#FFB800"
            android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="3dp">
        <TextView android:layout_width="18dp" android:layout_height="18dp"
            android:background="@drawable/widget_preview_bg_red" android:gravity="center"
            android:text="🏪" android:textSize="10sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp" android:text="다이소"
            android:textColor="#191F28" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/widget_preview_pill_red" android:paddingHorizontal="6dp"
            android:paddingVertical="1dp" android:text="3" android:textColor="#F04452"
            android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
