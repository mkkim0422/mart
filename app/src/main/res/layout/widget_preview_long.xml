<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews-safe: dividers are <ImageView>, never bare <View>.
     Long = ONE mart, full-height item list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_pv_card"
    android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="8dp">
        <TextView android:layout_width="24dp" android:layout_height="24dp"
            android:background="@drawable/widget_preview_bg_blue" android:gravity="center"
            android:text="📦" android:textSize="13sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp" android:text="쿠팡"
            android:textColor="#191F28" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/widget_preview_pill_blue" android:paddingHorizontal="7dp"
            android:paddingVertical="2dp" android:text="6" android:textColor="#3182F6"
            android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <ImageView android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#F0EEE9" android:contentDescription="@null" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="•  생수" android:textColor="#191F28" android:textSize="14sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="•  세제" android:textColor="#191F28" android:textSize="14sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="•  우유" android:textColor="#191F28" android:textSize="14sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="•  계란" android:textColor="#191F28" android:textSize="14sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="•  바나나" android:textColor="#191F28" android:textSize="14sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="•  라면" android:textColor="#191F28" android:textSize="14sp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="+ 2개 더" android:textColor="#B0B0B0" android:textSize="12sp" />
</LinearLayout>
