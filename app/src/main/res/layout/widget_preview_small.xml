<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews-safe: no bare <View>. Small = per-mart counts. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_pv_card"
    android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="6dp">
        <TextView android:layout_width="20dp" android:layout_height="20dp"
            android:background="@drawable/widget_preview_bg_yellow" android:gravity="center"
            android:text="🛒" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp" android:text="이마트"
            android:textColor="#191F28" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/widget_preview_pill_yellow" android:paddingHorizontal="6dp"
            android:paddingVertical="1dp" android:text="5" android:textColor="#FFB800"
            android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="6dp">
        <TextView android:layout_width="20dp" android:layout_height="20dp"
            android:background="@drawable/widget_preview_bg_red" android:gravity="center"
            android:text="🏪" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp" android:text="다이소"
            android:textColor="#191F28" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/widget_preview_pill_red" android:paddingHorizontal="6dp"
            android:paddingVertical="1dp" android:text="3" android:textColor="#F04452"
            android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="6dp">
        <TextView android:layout_width="20dp" android:layout_height="20dp"
            android:background="@drawable/widget_preview_bg_blue" android:gravity="center"
            android:text="📦" android:textSize="11sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp" android:text="쿠팡"
            android:textColor="#191F28" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/widget_preview_pill_blue" android:paddingHorizontal="6dp"
            android:paddingVertical="1dp" android:text="1" android:textColor="#3182F6"
            android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:text="외 1개 마트"
        android:textColor="#B0B0B0"
        android:textSize="11sp" />
</LinearLayout>
