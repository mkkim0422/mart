<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews-safe: dividers/dots are <ImageView>, never bare <View>. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_pv_card"
    android:padding="14dp">

    <!-- 이마트 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="10dp">
            <TextView android:layout_width="24dp" android:layout_height="24dp"
                android:background="@drawable/widget_preview_bg_yellow" android:gravity="center"
                android:text="🛒" android:textSize="13sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp" android:text="이마트"
                android:textColor="#191F28" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/widget_preview_pill_yellow" android:paddingHorizontal="7dp"
                android:paddingVertical="2dp" android:text="4" android:textColor="#FFB800" android:textSize="11sp" />
        </LinearLayout>
        <ImageView android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#F0EEE9" android:contentDescription="@null" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
            <ImageView android:layout_width="6dp" android:layout_height="6dp"
                android:background="@drawable/widget_preview_dot" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:text="라면" android:textColor="#191F28" android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
            <ImageView android:layout_width="6dp" android:layout_height="6dp"
                android:background="@drawable/widget_preview_dot" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:text="홈런볼" android:textColor="#191F28" android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
            <ImageView android:layout_width="6dp" android:layout_height="6dp"
                android:background="@drawable/widget_preview_dot" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:text="바나나우유" android:textColor="#191F28" android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
            <ImageView android:layout_width="6dp" android:layout_height="6dp"
                android:background="@drawable/widget_preview_dot" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:text="사과" android:textColor="#191F28" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView android:layout_width="1dp" android:layout_height="match_parent"
        android:background="#F0EEE9" android:contentDescription="@null" />

    <!-- 다이소 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="10dp">
            <TextView android:layout_width="24dp" android:layout_height="24dp"
                android:background="@drawable/widget_preview_bg_red" android:gravity="center"
                android:text="🏪" android:textSize="13sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp" android:text="다이소"
                android:textColor="#191F28" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/widget_preview_pill_red" android:paddingHorizontal="7dp"
                android:paddingVertical="2dp" android:text="3" android:textColor="#F04452" android:textSize="11sp" />
        </LinearLayout>
        <ImageView android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#F0EEE9" android:contentDescription="@null" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
            <ImageView android:layout_width="6dp" android:layout_height="6dp"
                android:background="@drawable/widget_preview_dot" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:text="모공크림" android:textColor="#191F28" android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
            <ImageView android:layout_width="6dp" android:layout_height="6dp"
                android:background="@drawable/widget_preview_dot" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:text="휴대폰 케이블" android:textColor="#191F28" android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
            <ImageView android:layout_width="6dp" android:layout_height="6dp"
                android:background="@drawable/widget_preview_dot" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:text="수세미" android:textColor="#191F28" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
