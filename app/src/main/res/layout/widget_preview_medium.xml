<?xml version="1.0" encoding="utf-8"?>
<!-- 목록 위젯 picker preview: one mart, ○ rows, one "+". RemoteViews-safe: no bare <View>. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_pv_card"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="10dp">
            <TextView android:layout_width="24dp" android:layout_height="24dp"
                android:background="@drawable/widget_preview_bg_blue" android:gravity="center"
                android:text="🚀" android:textSize="13sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp" android:text="쿠팡"
                android:textColor="#191F28" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/widget_preview_pill_blue" android:paddingHorizontal="7dp"
                android:paddingVertical="2dp" android:text="4" android:textColor="#3182F6" android:textSize="11sp" />
        </LinearLayout>
        <ImageView android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#F0EEE9" android:contentDescription="@null" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/widget_check_off" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:text="생수 2L" android:textColor="#191F28" android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/widget_check_off" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:text="물티슈" android:textColor="#191F28" android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/widget_check_off" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:text="키친타월" android:textColor="#191F28" android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/widget_check_off" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:text="세탁세제" android:textColor="#191F28" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="bottom|end"
        android:src="@drawable/widget_fab"
        android:contentDescription="@null" />
</FrameLayout>
