<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews-safe: dividers are <ImageView>, never bare <View>. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_pv_card"
    android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="8dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="마트노트" android:textColor="#191F28" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="전체 11개" android:textColor="#B0B0B0" android:textSize="11sp" />
    </LinearLayout>
    <ImageView android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#F0EEE9" android:contentDescription="@null" />

    <!-- Row 1: 이마트 / 다이소 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal" android:layout_marginTop="10dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:paddingEnd="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="6dp">
                <TextView android:layout_width="22dp" android:layout_height="22dp"
                    android:background="@drawable/widget_preview_bg_yellow" android:gravity="center"
                    android:text="🛒" android:textSize="12sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="6dp" android:text="이마트"
                    android:textColor="#191F28" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@drawable/widget_preview_pill_yellow" android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp" android:text="3" android:textColor="#FFB800" android:textSize="10sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="•  라면" android:textColor="#191F28" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="•  홈런볼" android:textColor="#191F28" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="•  바나나우유" android:textColor="#191F28" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="6dp">
                <TextView android:layout_width="22dp" android:layout_height="22dp"
                    android:background="@drawable/widget_preview_bg_red" android:gravity="center"
                    android:text="🏪" android:textSize="12sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="6dp" android:text="다이소"
                    android:textColor="#191F28" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@drawable/widget_preview_pill_red" android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp" android:text="3" android:textColor="#F04452" android:textSize="10sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="•  모공크림" android:textColor="#191F28" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="•  휴대폰 케이블" android:textColor="#191F28" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="•  수세미" android:textColor="#191F28" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#F0EEE9" android:layout_marginTop="10dp" android:contentDescription="@null" />

    <!-- Row 2: 쿠팡 / 마켓컬리 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal" android:layout_marginTop="10dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:paddingEnd="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="6dp">
                <TextView android:layout_width="22dp" android:layout_height="22dp"
                    android:background="@drawable/widget_preview_bg_blue" android:gravity="center"
                    android:text="📦" android:textSize="12sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="6dp" android:text="쿠팡"
                    android:textColor="#191F28" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@drawable/widget_preview_pill_blue" android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp" android:text="3" android:textColor="#3182F6" android:textSize="10sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="•  키친타올" android:textColor="#191F28" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="•  생수" android:textColor="#191F28" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="•  세제" android:textColor="#191F28" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="6dp">
                <TextView android:layout_width="22dp" android:layout_height="22dp"
                    android:background="@drawable/widget_preview_bg_purple" android:gravity="center"
                    android:text="🛍" android:textSize="12sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="6dp" android:text="마켓컬리"
                    android:textColor="#191F28" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@drawable/widget_preview_pill_purple" android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp" android:text="2" android:textColor="#8B5CF6" android:textSize="10sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="•  샐러드" android:textColor="#191F28" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="•  그릭요거트" android:textColor="#191F28" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
