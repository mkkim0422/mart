<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 마트노트 cart — geometry traced from the remade design
         (assets-from-design/icon/new): blue cart + 3 mart-color dots
         (blue/yellow/red) + 2 wheels.
         The <group> scales the raw artwork to 0.84 and re-centers it on
         (54,54): raw bbox was 57x46 @ center (50.5,52.5) with an
         enclosing radius of ~35.7dp, which OVERFLOWED the 66dp adaptive
         safe-zone (radius 33) and looked cropped/꽉찬 under launcher
         masks. Scaled it sits at ~48x39, enclosing radius ~30dp, with
         comfortable margin — matching the home-screen reference
         (assets-from-design/icon/new/_ _ _ _ _ _.png, cart ≈ 68% of tile). -->
    <group
        android:pivotX="50.465"
        android:pivotY="52.45"
        android:scaleX="0.84"
        android:scaleY="0.84"
        android:translateX="3.535"
        android:translateY="1.55">
        <!-- cart handle -->
        <path
            android:pathData="M24.4,32 L31.2,32 L36.53,43.94"
            android:fillColor="#00000000"
            android:strokeColor="#3182F6"
            android:strokeWidth="5.1"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- cart basket (trapezoid, wider at the top) -->
        <path
            android:pathData="M36.53,43.94 L76.53,43.94 L70.51,63.62 L43.73,63.62 Z"
            android:fillColor="#00000000"
            android:strokeColor="#3182F6"
            android:strokeWidth="5.1"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- wheels -->
        <path
            android:pathData="M45.24,71.15 a4.3,4.3 0 1,0 8.6,0 a4.3,4.3 0 1,0 -8.6,0 Z"
            android:fillColor="#3182F6" />
        <path
            android:pathData="M60.4,71.15 a4.3,4.3 0 1,0 8.6,0 a4.3,4.3 0 1,0 -8.6,0 Z"
            android:fillColor="#3182F6" />
        <!-- 3 mart-color item dots (Blue / Yellow / Red, left to right) -->
        <path
            android:pathData="M44.81,54.48 a3.76,3.76 0 1,0 7.52,0 a3.76,3.76 0 1,0 -7.52,0 Z"
            android:fillColor="#3182F6" />
        <path
            android:pathData="M53.3,54.48 a3.76,3.76 0 1,0 7.52,0 a3.76,3.76 0 1,0 -7.52,0 Z"
            android:fillColor="#FFB800" />
        <path
            android:pathData="M61.8,54.48 a3.76,3.76 0 1,0 7.52,0 a3.76,3.76 0 1,0 -7.52,0 Z"
            android:fillColor="#F04452" />
    </group>
</vector>
